{
	"name": "vault-crm",
	"version": "1.0.5",
	"description": "A CRM for Obsidian that stores clients, deals, and projects as plain markdown notes.",
	"author": "Abdulkader Safi <safi.abdulkader@gmail.com> (https://abdulkadersafi.com)",
	"repository": {
		"type": "git",
		"url": "https://github.com/Abdulkader-Safi/obsidian-crm-plugins"
	},
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "run-p dev:js dev:css",
		"dev:js": "node esbuild.config.mjs",
		"dev:css": "tailwindcss -i src/styles.css -o styles.css --watch",
		"build": "svelte-check --tsconfig ./tsconfig.json && run-s build:css build:js",
		"check": "svelte-check --tsconfig ./tsconfig.json",
		"build:js": "node esbuild.config.mjs production",
		"build:css": "tailwindcss -i src/styles.css -o styles.css --minify",
		"test": "bun test",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"crm",
		"svelte",
		"tailwindcss"
	],
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.21.0",
		"@tailwindcss/cli": "^4.3.1",
		"@types/node": "^22.15.17",
		"bits-ui": "^2.16.3",
		"esbuild": "0.25.5",
		"esbuild-svelte": "^0.9.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.3.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"npm-run-all2": "^7.0.2",
		"obsidian": "latest",
		"svelte": "^5.56.3",
		"svelte-check": "^4.6.0",
		"svelte-preprocess": "^6.0.5",
		"svelte-sonner": "^1.1.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"overrides": {
		"brace-expansion@^5.0.0": "^5.0.6",
		"js-yaml": "^4.2.0"
	}
}
